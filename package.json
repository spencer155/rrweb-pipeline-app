{
  "name": "rrweb-pipeline",
  "version": "1.1.0",
  "description": "将 rrweb JSON 导出为 MP4 并可选合并",
  "main": "main.cjs",
  "author": "sun",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall-copy-player.cjs",
    "predist": "node scripts/ensure-binaries.cjs",
    "predist:arm64": "node scripts/ensure-binaries.cjs",
    "predist:x64": "node scripts/ensure-binaries.cjs",
    "predist:win": "node scripts/ensure-binaries.cjs",
    "pack": "node scripts/ensure-binaries.cjs && electron-builder --dir",
    "dist": "electron-builder",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:x64": "electron-builder --mac --x64",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "bxs-rrweb-player-2": "^1.0.1",
    "ffmpeg-static": "^5.2.0",
    "pako": "^0.2.9",
    "puppeteer": "^5.5.0",
    "rrvideo": "file:vendor/local-rrvideo"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.rrweb.pipeline",
    "productName": "RRWeb视频导出",
    "files": [
      "main.cjs",
      "preload.cjs",
      "config.cjs",
      "lib/**/*",
      "renderer/**/*"
    ],
    "asarUnpack": [],
    "extraResources": [
      {
        "from": "node_modules/puppeteer/.local-chromium",
        "to": "chromium"
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": ["ffmpeg", "ffmpeg.exe"]
      },
      {
        "from": "node_modules/rrvideo",
        "to": "rrvideo",
        "filter": ["**/*", "!node_modules/**"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "directories": {
      "output": "release"
    }
  }
}
